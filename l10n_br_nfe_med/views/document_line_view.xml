<odoo>
    <record id="document_line_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.line.form (med)</field>
        <field name="model">l10n_br_fiscal.document.line</field>
        <field name="inherit_id" ref="l10n_br_nfe_rastro.document_line_form" />
        <field name="arch" type="xml">
            <page name="nfe40_rastro" position="before">
                <page name="nfe40_med" string="Medicine">
                    <group>
                        <field
                            name="nfe40_med"
                            context="{'form_view_ref': 'l10n_br_nfe_med.nfe_med_form'}"
                        />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
