<odoo>
    <record id="invoice_form" model="ir.ui.view">
        <field name="name">account.move.form (med)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_nfe_rastro.invoice_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/form//page[@name='nfe40_rastro']"
                position="before"
            >
                <page name="nfe40_med" string="Medicine">
                    <group>
                        <field
                            name="nfe40_med"
                            context="{'form_view_ref': 'l10n_br_nfe_med.nfe_med_form'}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
