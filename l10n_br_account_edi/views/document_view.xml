<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_account_edi.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field
                    name="edi_can_generate_invoice"
                    invisible="1"
                    groups="account.group_account_readonly,account.group_account_invoice"
                />
                <button
                    name="action_generate_invoice"
                    type="object"
                    string="Generate Invoice"
                    class="btn-primary"
                    groups="account.group_account_invoice"
                    attrs="{'invisible': [('edi_can_generate_invoice', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
