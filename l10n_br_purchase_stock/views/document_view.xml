<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_purchase_stock.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='fiscal_line_ids']/tree/field[@name='import_purchase_line_id']"
                position="after"
            >
                <field
                    name="import_stock_move_id"
                    optional="show"
                    attrs="{'column_invisible': [('parent.imported_document', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
    <record id="document_line_form" model="ir.ui.view">
        <field name="name">l10n_br_purchase_stock.document.line.form</field>
        <field name="model">l10n_br_fiscal.document.line</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_line_form" />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='import_purchase_line_id']" position="after">
                <field
                    name="import_stock_move_id"
                    attrs="{'invisible': [('fiscal_operation_type', '!=', 'in')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
