<odoo>
    <!-- CT-e specific list: the generic one plus the KPI banner and the
         CT-e buttons. Referenced explicitly by action_cte_dfe_document. The
         dfe_document_list js_class renders the DF-e banner, using the
         default_fiscal_type of the action context. -->
    <record model="ir.ui.view" id="cte_dfe_document_tree">
        <field name="name">l10n_br_fiscal_dfe.document.tree.cte</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list
                js_class="dfe_document_list"
                create="false"
                edit="false"
                delete="false"
                decoration-success="color_status == 'green'"
                decoration-muted="color_status == 'muted'"
            >
                <field
                    name="color_status"
                    widget="badge"
                    string="Type"
                    decoration-success="color_status == 'green'"
                    decoration-muted="color_status == 'muted'"
                />
                <field name="document_emission_date" string="Date" widget="date" />
                <field name="access_key" />
                <field name="document_number" string="Number" />
                <field name="emitter" />
                <field name="vat" />
                <field name="partner_id" />
                <field name="document_amount" string="Amount" widget="monetary" />
                <field name="currency_id" invisible="1" />
                <field name="fiscal_document_id" />
                <field name="document_state_label" string="State" />
                <field name="utilization" optional="show" />
                <field name="import_block_reason" optional="show" />
                <button
                    string="XML"
                    name="action_download_xml"
                    type="object"
                    icon="fa-file-code-o"
                />
                <button
                    string="DACTE"
                    name="make_pdf"
                    type="object"
                    icon="fa-file-pdf-o"
                />
                <button
                    name="import_document"
                    string="Import"
                    type="object"
                    icon="fa-file-text-o"
                    invisible="fiscal_document_id or import_block_reason"
                />
                <button
                    name="action_view_imported_document"
                    string="Fiscal Document"
                    type="object"
                    icon="fa-pencil-square-o"
                    invisible="not fiscal_document_id"
                />
            </list>
        </field>
    </record>

    <record id="action_cte_dfe_document" model="ir.actions.act_window">
        <field name="name">CT-e de Terceiros</field>
        <field name="res_model">l10n_br_fiscal_dfe.document</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('fiscal_type', '=', 'cte'), ('is_own_document', '=', False)]</field>
        <field
            name="context"
        >{'default_fiscal_type': 'cte', 'search_default_to_import': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'list',
                           'view_id': ref('cte_dfe_document_tree')}),
                   (0, 0, {'view_mode': 'form',
                           'view_id': ref('l10n_br_fiscal_dfe.l10n_br_fiscal_dfe_document_form')})]"
        />
    </record>

    <menuitem
        id="menu_l10n_br_cte_dfe_document"
        name="CT-e de Terceiros"
        action="action_cte_dfe_document"
        parent="l10n_br_fiscal_dfe.menu_l10n_br_fiscal_dfe_root"
        sequence="20"
    />
</odoo>
