<odoo>
    <!--
      The regime of the assessment goes into the form and the list of the tax
      group of the core, which the menu Accounting > Configuration > Tax Groups
      already opens: a new view and a new menu would leave the screen of the core
      without the field.
    -->
    <record id="view_tax_group_form_regime" model="ir.ui.view">
        <field name="name">account.tax.group.form.l10n_br_tax_assessment</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_form" />
        <field name="arch" type="xml">
            <field name="sequence" position="after">
                <field name="regime" />
            </field>
        </field>
    </record>

    <record id="view_tax_group_tree_regime" model="ir.ui.view">
        <field name="name">account.tax.group.tree.l10n_br_tax_assessment</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_tree" />
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="regime" />
            </field>
        </field>
    </record>

    <!--
      The menu of the core for the tax groups only shows in the developer mode.
      The fiscal user who sets the regime of the PIS and the COFINS gets the same
      action, with no copy of it, next to the assessment.
    -->
    <menuitem
        id="menu_tax_group_regime"
        name="Grupos de imposto (regime de apuração)"
        parent="account.menu_finance_entries_actions"
        action="account.action_tax_group"
        groups="account.group_account_manager"
        sequence="91"
    />
</odoo>
