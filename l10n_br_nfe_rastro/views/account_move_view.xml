<odoo>
    <record id="invoice_form" model="ir.ui.view">
        <field name="name">account.move.form (rastro)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account.invoice_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/form//page[@name='fiscal_line_extra_info']"
                position="before"
            >
                <page name="nfe40_rastro" string="Traceability">
                    <field
                        name="nfe40_rastro"
                        context="{'list_view_ref': 'l10n_br_nfe_rastro.nfe_rastro_list'}"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
