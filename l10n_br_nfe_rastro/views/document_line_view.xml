<odoo>
    <record id="document_line_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.line.form (rastro)</field>
        <field name="model">l10n_br_fiscal.document.line</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_line_form" />
        <field name="arch" type="xml">
            <page name="fiscal_line_extra_info" position="before">
                <page name="nfe40_rastro" string="Traceability">
