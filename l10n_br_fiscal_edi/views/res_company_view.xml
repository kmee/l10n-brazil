<odoo>
    <record id="res_company_form_import" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.res.company.form.import</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='edoc']" position="inside">
                <group name="import" string="Import of Fiscal Documents">
                    <field name="import_product_categ_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
