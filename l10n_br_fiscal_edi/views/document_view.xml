<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="document_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.document.search</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_search" />
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter
                    name="send"
                    string="Sending"
                    domain="[('state_edoc','=','enviada')]"
                />
                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('state_edoc','=','rejeitada')]"
                />
                <filter
                    name="authorized"
                    string="Authorized"
                    domain="[('state_edoc','=','autorizada')]"
                />
            </filter>
        </field>
    </record>

    <record id="document_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.document.tree</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_tree" />
        <field name="arch" type="xml">
            <field name="state_edoc" position="attributes">
                <attribute name="decoration-info">state_edoc == 'enviada'</attribute>
                <attribute
                    name="decoration-danger"
                >state_edoc == 'rejeitada'</attribute>
                <attribute
                    name="decoration-success"
                >state_edoc == 'autorizada'</attribute>
            </field>
        </field>
    </record>

    <!-- In the action menu and not in the header: four toolbar buttons push the
         search box off a narrow screen, and an action over the selected records
         is what the action menu exists to hold. -->

    <record id="action_download_xml" model="ir.actions.server">
        <field name="name">Download XML</field>
        <field name="model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_download_xml()</field>
    </record>

    <record id="action_download_report" model="ir.actions.server">
        <field name="name">Download DANFE</field>
        <field name="model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_download_report()</field>
    </record>

    <record id="action_download_xml_and_report" model="ir.actions.server">
        <field name="name">Download XML and DANFE</field>
        <field name="model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_download_xml_and_report()</field>
    </record>

    <record id="action_check_status" model="ir.actions.server">
        <field name="name">Check status at the SEFAZ</field>
        <field name="model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_check_status()</field>
    </record>

    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <button name="action_document_confirm" position="after">
                <button
                    name="action_document_correction"
                    type="object"
                    string="Carta de Correção"
                    groups="l10n_br_fiscal.group_user"
                    invisible="state_edoc != 'autorizada'"
                />
            </button>
            <button name="action_document_back2draft" position="before">
                <button
                    name="view_pdf"
                    type="object"
                    string="View PDF"
                    groups="l10n_br_fiscal.group_user"
                    class="btn-primary"
                    invisible="state_edoc in ('em_digitacao', 'a_enviar')"
                />
                <button
                    name="view_xml"
                    type="object"
                    string="View XML"
                    groups="l10n_br_fiscal.group_user"
                    class="btn-primary"
                    invisible="state_edoc in ('em_digitacao', 'a_enviar')"
                />
                <button
                    name="action_download_xml_and_report"
                    type="object"
                    string="Download XML and DANFE"
                    groups="l10n_br_fiscal.group_user"
                    invisible="state_edoc in ('em_digitacao', 'a_enviar')"
                />
            </button>
            <field name="state_edoc" position="attributes">
                <attribute
                    name="statusbar_visible"
                >em_digitacao,a_enviar,enviada,autorizada</attribute>
            </field>
            <xpath expr="//page[@name='delivery']" position="after">
                <page name="others" string="EDI">
                    <group>
                        <field name="operation_name" />
                        <field
                            name="status_description"
                            invisible="document_electronic == '0'"
                        />
                    </group>
                    <group>
                        <group name="authorization" string="Authorization" colspan="4">
                            <field name="authorization_event_id" />
                            <field name="authorization_date" />
                            <field name="authorization_protocol" />
                            <field name="send_file_id" />
                            <field name="authorization_file_id" />
                            <field name="file_report_id" />
                        </group>
                        <group
                            name="cancel"
                            string="Cancellation"
                            colspan="4"
                            invisible="state_edoc != 'cancelada'"
                        >
                            <field name="cancel_event_id" />
                            <field name="cancel_date" />
                            <field name="cancel_protocol_number" />
                            <field name="cancel_reason" />
                            <field name="cancel_file_id" />
                        </group>
                        <group
                            name="corrections"
                            string="Corrections"
                            colspan="4"
                            invisible="not correction_event_ids"
                        >
                            <field name="correction_event_ids" nolabel="1" colspan="2">
                                <list>
                                    <field name="id" />
                                    <field name="justification" />
                                    <field name="create_date" />
                                    <field name="state" />
                                    <button
                                        name="print_document_event"
                                        title="Print Document Event"
                                        icon="fa-print"
                                        type="object"
                                    />
                                </list>
                            </field>
                        </group>
                        <group name="events" string="Events and Services" colspan="4">
                            <field name="event_ids" nolabel="1" colspan="2">
                                <list>
                                    <field name="id" />
                                    <field name="type" />
                                    <field name="origin" />
                                    <field name="create_date" />
                                    <field name="state" />
                                </list>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
