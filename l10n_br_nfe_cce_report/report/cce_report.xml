<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_cce" model="ir.actions.report">
        <field name="name">Carta de Correção (CC-e)</field>
        <field name="model">l10n_br_fiscal.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_br_nfe_cce_report.report_cce</field>
        <field name="report_file">l10n_br_nfe_cce_report.report_cce</field>
        <field
            name="print_report_name"
        >'CCe-%s-NFe-%s-serie-%s' % (object.sequence or '', object.document_number or '', object.document_serie_id.code or '')</field>
        <field
            name="binding_model_id"
            ref="l10n_br_fiscal_edi.model_l10n_br_fiscal_event"
        />
        <field name="binding_type">report</field>
    </record>
</odoo>
