<odoo>
    <record id="document_form_landed_costs" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form.landed.costs</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_landed_costs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    attrs="{'invisible': [('landed_cost_count', '=', 0)]}"
                    groups="stock.group_stock_manager"
                >
                    <field
                        name="landed_cost_count"
                        widget="statinfo"
                        string="Landed Costs"
                    />
                </button>
            </div>
            <notebook position="inside">
                <page
                    name="landed_costs"
                    string="Landed Costs"
                    attrs="{'invisible': [('fiscal_operation_type', '!=', 'in')]}"
                    groups="stock.group_stock_manager"
                >
                    <group>
                        <field name="landed_cost_split_method" />
                        <field
                            name="landed_cost_picking_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                        />
                    </group>
                    <button
                        name="action_create_landed_cost"
                        type="object"
                        string="Create Landed Cost"
                        class="btn-primary"
                    />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
