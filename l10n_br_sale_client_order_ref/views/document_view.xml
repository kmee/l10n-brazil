<odoo>
    <record id="document_form" model="ir.ui.view">
        <field
            name="name"
        >l10n_br_fiscal.document.form (in l10n_br_sale_client_order_ref)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra_info']/group" position="inside">
                <field name="sale_id" />
                <field name="client_order_ref" />
            </xpath>
        </field>
    </record>

    <record id="document_tree" model="ir.ui.view">
        <field
            name="name"
        >l10n_br_fiscal.document.list (in l10n_br_sale_client_order_ref)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='document_number']" position="after">
                <field name="client_order_ref" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
