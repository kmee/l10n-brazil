<odoo>
    <record id="fiscal_comment_client_order_ref" model="l10n_br_fiscal.comment">
        <field name="name">Referência do cliente</field>
        <field
            name="comment"
        >${("Referência do cliente: %s" % doc.client_order_ref) if doc.client_order_ref else ""}</field>
        <field name="comment_type">commercial</field>
        <field name="object">l10n_br_fiscal.document.mixin</field>
    </record>

    <record id="l10n_br_fiscal.fo_venda" model="l10n_br_fiscal.operation">
        <field
            name="comment_ids"
            eval="[Command.link(ref('fiscal_comment_client_order_ref'))]"
        />
    </record>
</odoo>
