<odoo>
    <!--
      The whole routine on the demo company of the assessment demo
      (l10n_br_tax_assessment): the accountant of register 0100, one supplier
      invoice as the NF-e import leaves it, the ICMS and IPI assessments of the
      month closed, and the EFD ICMS/IPI of the month pulled and generated.
      The period is the install month, like the assessment demo.
    -->
    <record id="demo_accountant" model="res.partner">
        <field name="name">Contador de Demonstracao</field>
        <field name="is_company" eval="False" />
        <field name="is_accountant" eval="True" />
        <field name="cnpj_cpf">111.444.777-35</field>
        <field name="crc_code">1SP123456/O-0</field>
        <field name="crc_state_id" ref="base.state_br_sp" />
        <field name="zip">01311-000</field>
        <field name="street_name">Avenida Paulista</field>
        <field name="street_number">1</field>
        <field name="district">Bela Vista</field>
        <field name="phone">11999999999</field>
        <field name="email">contador@example.com</field>
        <field name="country_id" ref="base.br" />
        <field name="state_id" ref="base.state_br_sp" />
        <field name="city_id" ref="l10n_br_base.city_3550308" />
    </record>
    <record id="l10n_br_base.empresa_lucro_presumido" model="res.company">
        <field name="accountant_id" ref="demo_accountant" />
    </record>

    <!--
      A resale purchase, imported and authorized: it carries the ICMS credit of
      C170 and C190. The access key is fixed (its check digit is right); its
      year and month are those of when the demo was written.
    -->
    <record id="demo_entry_document" model="l10n_br_fiscal.document">
        <field name="company_id" ref="l10n_br_base.empresa_lucro_presumido" />
        <field name="fiscal_operation_id" ref="l10n_br_fiscal.fo_compras" />
        <field name="fiscal_operation_type">in</field>
        <field name="document_type_id" ref="l10n_br_fiscal.document_55" />
        <field name="document_number">1001</field>
        <field name="document_serie">1</field>
        <field name="document_key">35261186144802000190550010000010011000010011</field>
        <field name="issuer">partner</field>
        <field name="partner_id" ref="l10n_br_base.res_partner_intel" />
        <field
            name="document_date"
            eval="(DateTime.today() + relativedelta(day=1, hour=12)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field
            name="date_in_out"
            eval="(DateTime.today() + relativedelta(day=1, hour=12)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="state_edoc">autorizada</field>
        <field name="imported_document" eval="True" />
    </record>
    <record id="demo_entry_document_line" model="l10n_br_fiscal.document.line">
        <field name="document_id" ref="demo_entry_document" />
        <field name="name">Mercadoria para revenda</field>
        <field name="product_id" ref="product.product_product_6" />
        <field name="fiscal_operation_id" ref="l10n_br_fiscal.fo_compras" />
        <field
            name="fiscal_operation_line_id"
            ref="l10n_br_fiscal.fo_compras_compras_comercializacao"
        />
        <field name="fiscal_operation_type">in</field>
        <field name="quantity">10</field>
        <field name="price_unit">100.0</field>
        <field name="partner_cfop_id" ref="l10n_br_fiscal.cfop_5102" />
        <field name="icms_origin">0</field>
        <field name="icms_tax_id" ref="l10n_br_fiscal.tax_icms_18" />
        <field name="icms_cst_id" ref="l10n_br_fiscal.cst_icms_00" />
        <field name="icms_base">1000.0</field>
        <field name="icms_percent">18.0</field>
        <field name="icms_value">180.0</field>
        <field name="pis_tax_id" ref="l10n_br_fiscal.tax_pis_1_65" />
        <field name="pis_cst_id" ref="l10n_br_fiscal.cst_pis_01" />
        <field name="pis_base">1000.0</field>
        <field name="pis_percent">1.65</field>
        <field name="pis_value">16.5</field>
        <field name="cofins_tax_id" ref="l10n_br_fiscal.tax_cofins_7_6" />
        <field name="cofins_cst_id" ref="l10n_br_fiscal.cst_cofins_01" />
        <field name="cofins_base">1000.0</field>
        <field name="cofins_percent">7.6</field>
        <field name="cofins_value">76.0</field>
    </record>

    <!-- the file only goes out with the assessments of the period closed -->
    <function
        model="l10n_br_tax.assessment"
        name="action_post"
        eval="[[ref('l10n_br_tax_assessment.demo_assessment_icms'), ref('l10n_br_tax_assessment.demo_assessment_ipi')]]"
    />

    <record id="demo_declaration" model="l10n_br_sped.efd_icms_ipi.0000">
        <field name="company_id" ref="l10n_br_base.empresa_lucro_presumido" />
        <field
            name="DT_INI"
            eval="(DateTime.today() + relativedelta(day=1)).strftime('%Y-%m-%d')"
        />
        <field
            name="DT_FIN"
            eval="(DateTime.today() + relativedelta(day=31)).strftime('%Y-%m-%d')"
        />
    </record>
    <function
        model="l10n_br_sped.efd_icms_ipi.0000"
        name="button_populate_sped_from_odoo"
        eval="[[ref('demo_declaration')]]"
    />
    <function
        model="l10n_br_sped.efd_icms_ipi.0000"
        name="button_create_sped_files"
        eval="[[ref('demo_declaration')]]"
    />
</odoo>
