#. module: l10n_br_purchase_stock_edi
#. odoo-python
#: code:addons/l10n_br_purchase_stock_edi/models/document.py:0
#, python-format
msgid ""
"%(count)s line(s) of stockable products have no order and no receipt. Use "
"Match with Orders to create the receipt, or ask a purchase or stock manager "
"to mark the line as without stock entry."
msgstr ""
"%(count)s linha(s) de produtos estocáveis sem pedido e sem recebimento. Use "
"Conciliar com pedidos para criar o recebimento, ou peça a um gerente de "
"compras ou de estoque para marcar a linha como sem entrada em estoque."

#. module: l10n_br_purchase_stock_edi
#. odoo-python
#: code:addons/l10n_br_purchase_stock_edi/models/stock_move.py:0
#, python-format
msgid "%s is not tracked by lot."
msgstr "%s não tem rastreio por lote."

#. module: l10n_br_purchase_stock_edi
#. odoo-python
#: code:addons/l10n_br_purchase_stock_edi/models/document_match.py:0
#, python-format
msgid "%s line(s) marked as without stock entry."
msgstr "%s linha(s) marcada(s) como sem entrada em estoque."

#. module: l10n_br_purchase_stock_edi
#. odoo-python
#: code:addons/l10n_br_purchase_stock_edi/models/stock_picking.py:0
#, python-format
msgid "%s move(s) received the lots of the document."
