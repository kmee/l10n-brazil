#. module: l10n_br_purchase_stock_edi
#: model_terms:ir.ui.view,arch_db:l10n_br_purchase_stock_edi.document_form
msgid ""
"<span class=\"badge text-bg-warning\">Divergent</span>\n"
"                    Some line differs from the order or the receipt by more "
"than\n"
"                    the tolerance of the company."
msgstr ""
"<span class=\"badge text-bg-warning\">Divergente</span>\n"
"                    Alguma linha difere do pedido ou do recebimento por mais "
"que\n"
"                    a tolerância da empresa."

#. module: l10n_br_purchase_stock_edi
#: model:ir.model.fields,help:l10n_br_purchase_stock_edi.field_res_company__purchase_quantity_tolerance
msgid ""
"A line whose quantity differs from the received quantity by more than this "
"percentage (of the received quantity) is marked as divergent. It only warns: "
"nothing is blocked."
msgstr ""
"Uma linha cuja quantidade difere da recebida por mais que este percentual "
"(da quantidade recebida) é marcada como divergente. Só avisa: nada é "
"bloqueado."

#. module: l10n_br_purchase_stock_edi
#: model:ir.model.fields,help:l10n_br_purchase_stock_edi.field_res_company__purchase_price_tolerance
msgid ""
"A line whose unit price differs from the one of the purchase order line by "
"more than this percentage (of the order price) is marked as divergent. It "
"only warns: nothing is blocked."
msgstr ""
"Uma linha cujo preço unitário difere do da linha do pedido de compra por "
"mais que este percentual (do preço do pedido) é marcada como divergente. Só "
"avisa: nada é bloqueado."

#. module: l10n_br_purchase_stock_edi
#: model:ir.model.fields,help:l10n_br_purchase_stock_edi.field_account_move_line__import_no_stock_entry
#: model:ir.model.fields,help:l10n_br_purchase_stock_edi.field_l10n_br_fiscal_document_line__import_no_stock_entry
msgid ""
"A purchase manager or a stock manager decided that the goods of this line, "
"bought without an order, do not enter the stock."
msgstr ""
"Um gerente de compras ou de estoque decidiu que a mercadoria desta linha, "
"comprada sem pedido, não entra no estoque."

#. module: l10n_br_purchase_stock_edi
#. odoo-python
#: code:addons/l10n_br_purchase_stock_edi/models/document_match.py:0
#, python-format
msgid ""
"A receipt is created for lines of stockable products marked as without order "
"and with no receipt yet."
msgstr ""
"O recebimento é criado para linhas de produtos estocáveis marcadas como sem "
"pedido e ainda sem recebimento."

#. module: l10n_br_purchase_stock_edi
#: model:ir.model.fields,field_description:l10n_br_purchase_stock_edi.field_res_company__purchase_price_tolerance
