<odoo>
    <record id="invoice_form_purchase_divergence" model="ir.ui.view">
        <field name="name">l10n_br_purchase_stock_edi.invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_import_pickings"
                    type="object"
                    help="Show the receipts of the lines"
                    groups="purchase.group_purchase_user,stock.group_stock_user"
                    invisible="not import_picking_count"
                    icon="fa-truck"
                >
                    <field
                        name="import_picking_count"
                        widget="statinfo"
                        string="Receipts"
                    />
                </button>
            </xpath>
            <xpath expr="//form/header" position="inside">
                <field name="import_picking_count" invisible="1" />
                <button
                    name="action_fill_import_receipts"
                    type="object"
                    string="Fill Receipt from the Document"
                    groups="purchase.group_purchase_user,stock.group_stock_user"
                    invisible="not import_picking_count or state != 'draft'"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <field name="purchase_divergent" invisible="1" />
                <field name="purchase_awaiting_receipt" invisible="1" />
                <div
                    class="badge text-bg-warning"
                    invisible="not purchase_divergent"
                    title="Some line differs from the order or the receipt by more than the tolerance"
                >Divergent</div>
                <div
                    class="badge text-bg-info"
                    invisible="purchase_divergent or not purchase_awaiting_receipt"
                    title="Some line waits for the receipt of its order line. Nothing is blocked."
                >Awaiting receipt</div>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']"
                position="after"
            >
                <field name="purchase_ordered_qty" optional="hide" />
                <field name="purchase_received_qty" optional="hide" />
                <field name="purchase_qty_difference" optional="hide" />
                <field name="purchase_price_unit" optional="hide" />
                <field name="purchase_price_difference" optional="hide" />
                <field name="purchase_awaiting_receipt" optional="show" />
                <field name="purchase_divergent" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="invoice_search_purchase_divergence" model="ir.ui.view">
        <field name="name">l10n_br_purchase_stock_edi.invoice.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="purchase_divergent"
                    string="Divergent from the Order"
                    domain="[('purchase_divergent', '=', True)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
