<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">l10n_br_purchase_stock_edi.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <field name="show_propose_lots_from_import" invisible="1" />
                <button
                    name="action_propose_lots_from_import"
                    type="object"
                    string="Propose Lots from the Document"
                    attrs="{'invisible': [('show_propose_lots_from_import', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
