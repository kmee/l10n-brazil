<odoo>
    <record id="l10n_br_duimp_declaracao_form" model="ir.ui.view">
        <field name="name">l10n_br_duimp.declaracao.form.landed.costs</field>
        <field name="model">l10n_br_duimp.declaracao</field>
        <field name="inherit_id" ref="l10n_br_duimp.l10n_br_duimp_declaracao_form" />
        <field name="arch" type="xml">
            <button name="action_cancel" position="before">
                <button
                    name="action_link_receipts"
                    string="Link Receipts"
                    type="object"
                    states="open,locked"
                    groups="stock.group_stock_manager"
                />
                <button
                    name="action_create_landed_costs"
                    string="Create Landed Costs"
                    type="object"
                    states="open,locked"
                    groups="stock.group_stock_manager"
                />
            </button>
            <div name="button_box" position="inside">
                <button
                    name="action_view_receipts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    attrs="{'invisible': [('picking_count', '=', 0)]}"
                    groups="stock.group_stock_user"
                >
                    <field name="picking_count" widget="statinfo" string="Receipts" />
                </button>
                <button
                    name="action_view_landed_costs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-plus-square"
                    attrs="{'invisible': [('landed_cost_count', '=', 0)]}"
                    groups="stock.group_stock_manager"
                >
                    <field
                        name="landed_cost_count"
                        widget="statinfo"
                        string="Landed Costs"
                    />
                </button>
            </div>
            <field name="valor_aduaneiro" position="after">
                <field name="received_qty" />
                <field name="receipt_pending" invisible="1" />
            </field>
            <page name="costs" position="after">
                <page
                    string="Customs Expenses"
                    name="customs_expenses"
                    groups="stock.group_stock_manager"
                >
                    <field name="company_id" invisible="1" />
                    <field
                        name="expense_document_ids"
                        options="{'no_create': True}"
                        context="{'tree_view_ref': 'l10n_br_fiscal.document_tree'}"
                    />
                </page>
            </page>
        </field>
    </record>
</odoo>
