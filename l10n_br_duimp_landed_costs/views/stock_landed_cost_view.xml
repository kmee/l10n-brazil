<odoo>
    <record id="view_stock_landed_cost_form" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.l10n_br_duimp</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='valuation_adjustment_lines']/tree/field[@name='quantity']"
                position="after"
            >
                <field name="customs_value" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
