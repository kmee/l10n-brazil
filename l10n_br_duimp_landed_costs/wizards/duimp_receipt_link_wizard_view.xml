<odoo>
    <record id="duimp_receipt_link_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_duimp.receipt.link.wizard.form</field>
        <field name="model">l10n_br_duimp.receipt.link.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="declaracao_id" invisible="1" />
                <p>
                    Lines marked as suggested match the item by product and quantity.
                    Review them before confirming; items left without a receipt line
                    stay pending.
                </p>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="item_id" invisible="1" />
                        <field name="company_id" invisible="1" />
                        <field name="product_id" />
                        <field name="quantity" />
                        <field name="received_qty" />
                        <field name="move_id" options="{'no_create': True}" />
                        <field name="suggested" />
                    </tree>
                </field>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
