<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_dfe_import.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <div
                    class="alert alert-info"
                    role="alert"
                    attrs="{'invisible': [('import_state', 'in', [False, 'resolved'])]}"
                >
                    <field name="import_state" invisible="1" />
                    <field name="import_pending_count" invisible="1" />
                    This document was imported and is awaiting review: resolve
                    each line before generating the invoice.
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('import_warning', '=', False)]}"
                >
                    <field name="import_warning" nolabel="1" readonly="1" />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='fiscal_line_ids']/tree/field[@name='fiscal_amount_total']"
                position="after"
            >
                <field
                    name="import_state"
                    widget="badge"
                    decoration-success="import_state == 'resolved'"
                    decoration-warning="import_state in ('pending', 'matched')"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="dfe_document_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_dfe_import.dfe.document.form</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field
            name="inherit_id"
            ref="l10n_br_fiscal_dfe.l10n_br_fiscal_dfe_document_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="document_line_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_dfe_import.document.line.form</field>
        <field name="model">l10n_br_fiscal.document.line</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_line_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="import_state"
                    attrs="{'invisible': [('import_state', '=', False)]}"
                />
                <field
                    name="import_ncm_code"
                    attrs="{'invisible': [('import_ncm_code', '=', False)]}"
                />
                <button
                    name="action_resolve_line"
                    type="object"
                    string="Resolve"
                    class="btn-primary"
                    attrs="{'invisible': [('import_state', 'in', [False, 'resolved'])]}"
                />
            </field>
        </field>
    </record>

    <record id="document_import_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_dfe_import.document.search</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <filter name="draft" position="before">
                <filter
                    name="awaiting_review"
                    string="Awaiting Review"
                    domain="[('import_state', 'in', ('pending', 'in_progress'))]"
                />
            </filter>
        </field>
    </record>
</odoo>
