<odoo>
    <record id="document_import_dfe_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_dfe_import.wizard.form</field>
        <field name="model">l10n_br_fiscal_dfe_import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Fiscal Document">
                <field name="state" invisible="1" />
                <field name="dfe_document_id" invisible="1" />
                <group attrs="{'invisible': [('state', '!=', 'draft')]}">
                    <field name="access_key" />
                    <field name="attachment_ids" widget="many2many_binary" />
                </group>
                <group attrs="{'invisible': [('state', '!=', 'confirm')]}">
                    <field name="confirm_message" nolabel="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_confirm_acknowledgement"
                        type="object"
                        string="Register acknowledgement"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'confirm')]}"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="document_import_dfe_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Fiscal Document</field>
        <field name="res_model">l10n_br_fiscal_dfe_import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
