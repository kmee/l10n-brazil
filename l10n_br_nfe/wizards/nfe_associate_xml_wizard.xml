<odoo>
    <record id="nfe_associate_xml_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_nfe.associate.xml.wizard.form</field>
        <field name="model">l10n_br_nfe.associate.xml.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="document_id" />
                    <field name="xml_file" />
                </group>
                <footer>
                    <button
                        name="action_associate_xml"
                        type="object"
                        string="Associate XML"
                        class="btn-primary"
                        confirm="Use only when the SEFAZ authorized the NF-e and the answer did not reach Odoo. Continue?"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="nfe_associate_xml_wizard_action" model="ir.actions.act_window">
        <field name="name">Associate Authorized XML</field>
        <field name="res_model">l10n_br_nfe.associate.xml.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
