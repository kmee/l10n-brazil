<odoo>

    <record id="account_payment_mode_form" model="ir.ui.view">
        <field name="name">account.payment.mode.form.bacenpix</field>
        <field name="model">account.payment.mode</field>
        <field name="inherit_id" ref="account_payment_mode.account_payment_mode_form" />
        <field name="arch" type="xml">
            <field name="payment_method_id" position="after">
                <field name="bacenpix_provider_id" />
                <field name="bacenpix_charge_config_id" />
                <field
                    name="bacenpix_generate_on_post"
                    attrs="{'invisible': [('bacenpix_charge_config_id', '=', False)]}"
                />
            </field>
        </field>
    </record>

</odoo>
