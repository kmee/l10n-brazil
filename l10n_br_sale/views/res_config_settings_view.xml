<odoo>
    <record id="l10n_br_sale_res_config_settings_form" model="ir.ui.view">
        <field name="name">l10n_br_sale.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting
                    id="l10n_br_copy_note_setting"
                    help="Copy sale order notes in fiscal document"
                >
                    <field name="copy_note" />
                    <label for="copy_note" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
