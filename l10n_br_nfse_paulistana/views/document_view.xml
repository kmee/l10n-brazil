<odoo>
    <record id="nfse_paulistana_document_form_inherit" model="ir.ui.view">
        <field name="name">l10n_br_nfse_paulistana.document.form.inherit</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_nfse.nfse_document_form_inherit" />
        <field name="arch" type="xml">
            <field name="verify_code" position="after">
                <field
                    name="nfse_document_key"
                    invisible="document_type != 'SE'"
                />
            </field>
        </field>
    </record>
</odoo>
