<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_picking_vol_create_form" model="ir.ui.view">
        <field name="name">stock.picking.vol.create.form</field>
        <field name="model">stock.picking.vol.create</field>
        <field name="arch" type="xml">
            <form>
                <field name="picking_id" invisible="1" />
                <field name="move_id" invisible="1" />
                <group>
                    <group>
                        <field name="quantity" />
                        <field name="kind" />
                        <field name="brand" />
                        <field name="number" />
                    </group>
                    <group>
                        <field name="net_weight" />
                        <field name="gross_weight" />
                    </group>
                </group>
                <separator string="Lots in the Volume" />
                <field name="line_ids" nolabel="1">
                    <list editable="top" create="false" delete="false">
                        <field name="move_line_id" column_invisible="1" />
                        <field name="product_id" />
                        <field name="lot_id" />
                        <field name="quantity" />
                        <field name="product_uom_id" />
                        <field name="selected" readonly="0" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create_volume"
                        type="object"
                        string="Create Volume"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_vol_create" model="ir.actions.act_window">
        <field name="name">Create Volume</field>
        <field name="res_model">stock.picking.vol.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
