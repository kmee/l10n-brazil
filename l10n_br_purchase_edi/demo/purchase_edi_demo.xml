<?xml version="1.0" encoding="utf-8" ?>
<!--
    Demo of the purchases link, in the company "Empresa Lucro Presumido".

    Three NF-e of one supplier, each in a different step of the life cycle:
    - 35261073623891000106550010000020011200100011: declares order
      PO-DEMO-EDI-001 and its item 1, and the supplier has no mapping of the
      product: the product comes from the order line and the line enters
      resolved. The order is invoiced by the bill generated from the note and
      the bill is posted.
    - 35261073623891000106550010000020021200200021: no order reference. The
      supplier has a quotation (PO-DEMO-EDI-002) for the product, so the note
      is waiting for the review in "Match with Orders".
    - 35261073623891000106550010000020031200300031: product with no order
      and no quotation, to be marked as without order.
-->
<odoo noupdate="1">
    <record id="demo_product_a" model="product.template">
        <field name="name">Memória DDR4 8 GB</field>
        <field name="type">consu</field>
        <field name="purchase_ok" eval="True" />
        <field name="purchase_method">purchase</field>
        <field name="ncm_id" ref="l10n_br_fiscal.ncm_00000000" />
    </record>
    <record id="demo_product_b" model="product.template">
        <field name="name">Fonte ATX 500 W</field>
        <field name="type">consu</field>
        <field name="purchase_ok" eval="True" />
        <field name="purchase_method">purchase</field>
        <field name="ncm_id" ref="l10n_br_fiscal.ncm_00000000" />
    </record>
    <record id="demo_product_c" model="product.template">
        <field name="name">Cabo SATA 50 cm</field>
        <field name="type">consu</field>
        <field name="purchase_ok" eval="True" />
        <field name="purchase_method">purchase</field>
        <field name="ncm_id" ref="l10n_br_fiscal.ncm_00000000" />
    </record>

    <!-- what the supplier calls the products B and C: the notes enter with them chosen.
         Product A has no mapping: the order that note 1 declares gives it. -->
    <record id="demo_supplierinfo_b" model="product.supplierinfo">
        <field name="partner_id" ref="l10n_br_base.res_partner_dell" />
        <field name="product_tmpl_id" ref="demo_product_b" />
        <field
            name="product_id"
            search="[('product_tmpl_id', '=', ref('demo_product_b'))]"
        />
        <field name="product_code">FNT-ATX-500</field>
        <field name="price">140.0</field>
    </record>
    <record id="demo_supplierinfo_c" model="product.supplierinfo">
        <field name="partner_id" ref="l10n_br_base.res_partner_dell" />
        <field name="product_tmpl_id" ref="demo_product_c" />
        <field
            name="product_id"
            search="[('product_tmpl_id', '=', ref('demo_product_c'))]"
        />
        <field name="product_code">CAB-SATA-50</field>
        <field name="price">140.0</field>
    </record>

    <!-- the confirmed order that the first note declares -->
    <record id="demo_order_confirmed" model="purchase.order">
        <field name="name">PO-DEMO-EDI-001</field>
        <field name="partner_id" ref="l10n_br_base.res_partner_dell" />
        <field name="company_id" ref="l10n_br_base.empresa_lucro_presumido" />
    </record>
    <record id="demo_order_confirmed_line" model="purchase.order.line">
        <field name="order_id" ref="demo_order_confirmed" />
        <field
            name="product_id"
            search="[('product_tmpl_id', '=', ref('demo_product_a'))]"
        />
        <field name="name">Memória DDR4 8 GB</field>
        <field name="product_qty">5</field>
        <field name="product_uom" ref="uom.product_uom_unit" />
        <field name="price_unit">140.0</field>
        <field name="date_planned" eval="DateTime.now()" />
    </record>
    <function model="purchase.order" name="button_confirm">
        <value eval="[ref('demo_order_confirmed')]" />
    </function>

    <!-- the quotation of the second note: not confirmed -->
    <record id="demo_order_quotation" model="purchase.order">
        <field name="name">PO-DEMO-EDI-002</field>
        <field name="partner_id" ref="l10n_br_base.res_partner_dell" />
        <field name="company_id" ref="l10n_br_base.empresa_lucro_presumido" />
    </record>
    <record id="demo_order_quotation_line" model="purchase.order.line">
        <field name="order_id" ref="demo_order_quotation" />
        <field
            name="product_id"
            search="[('product_tmpl_id', '=', ref('demo_product_b'))]"
        />
        <field name="name">Fonte ATX 500 W</field>
        <field name="product_qty">5</field>
        <field name="product_uom" ref="uom.product_uom_unit" />
        <field name="price_unit">140.0</field>
        <field name="date_planned" eval="DateTime.now()" />
    </record>

    <function model="l10n_br_fiscal.document.import.wizard" name="_import_demo_files">
        <value>l10n_br_purchase_edi</value>
        <value
            eval="[
                'demo/import/nfe_35261073623891000106550010000020011200100011.xml',
                'demo/import/nfe_35261073623891000106550010000020021200200021.xml',
                'demo/import/nfe_35261073623891000106550010000020031200300031.xml',
            ]"
        />
    </function>

    <!-- first note: the bill was generated linked to the order line and is
         posted, and the order shows as invoiced -->
    <function model="account.move" name="action_post">
        <value
            model="account.move"
            search="[('fiscal_document_id.document_key', '=', '35261073623891000106550010000020011200100011')]"
        />
    </function>

    <!-- third note: the review decided that there is no order -->
    <function model="l10n_br_fiscal.document.line" name="write">
        <value
            model="l10n_br_fiscal.document.line"
            search="[('document_id.document_key', '=', '35261073623891000106550010000020031200300031')]"
        />
        <value eval="{'import_origin_state': 'no_order'}" />
    </function>
</odoo>
